#!/usr/bin/env bash
# Tests for the OceanCanvas workspace adapter (setup, teardown, and the
# Compose / Makefile / Vite consumers of compose/.env).
#
#   bash .config/workspace/test            everything (needs Docker + gallery/node_modules)
#   OC_WS_TEST_NO_DOCKER=1 bash ...        skip the tests that use the real Docker daemon
#
# Destructive-test safety (README.md, "Testing destructive scoping"): the
# harness never relies on the teardown under test for its own scoping.
#   1. Contract and mutation tests run teardown against a FAKE `docker` that
#      only records its arguments, with DOCKER_HOST pointing at a socket that
#      doesn't exist, so the real daemon is unreachable even via /usr/bin/docker.
#      Deliberately broken teardown copies run ONLY there.
#   2. Real-daemon tests run only the unmodified teardown, behind a guard shim
#      that is independent of it: it allows `docker info` and
#      `docker compose -p oc-wstest-<pid>-<x> down [--remove-orphans] [--volumes]`
#      and refuses (exit 97, logged) anything else.
#   3. Everything outside the oc-wstest-<pid>- namespace (containers, images,
#      volumes, networks) is snapshotted before and compared after.
#   4. The harness's own fixture cleanup only names oc-wstest-<pid>- objects,
#      each checked against that pattern before any removal.
# Hermetic otherwise: scratch Git repos and a stubbed `wb-workspace port`.
# Uses only node:20-slim locally (no pulls).
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SETUP="$ROOT/.config/workspace/setup"
TEARDOWN="$ROOT/.config/workspace/teardown"
NODE=$(cd "$ROOT" && mise which node 2>/dev/null || command -v node)
REAL_DOCKER=$(command -v docker || true)   # resolved before any PATH shim
T=$(mktemp -d)
ID="oc-wstest-$$"
NS_RE="^$ID-[a-z0-9]+\$"
pass=0 fail=0

ok()   { pass=$((pass + 1)); echo "ok   $*"; }
bad()  { fail=$((fail + 1)); echo "FAIL $*"; }
check() { local d=$1; shift; if "$@"; then ok "$d"; else bad "$d"; fi; }
checks() { local d=$1; shift; if eval "$1"; then ok "$d"; else bad "$d"; fi; }   # compound condition

real_docker_ok() { [ "${OC_WS_TEST_NO_DOCKER:-}" != 1 ] && [ -n "$REAL_DOCKER" ] && "$REAL_DOCKER" info >/dev/null 2>&1; }
ns_ok() { [[ $1 =~ $NS_RE ]]; }

# Harness-owned fixture removal: only exact oc-wstest-<pid>-<x> names.
cleanup_docker() {
  real_docker_ok || return 0
  local p ref
  for p in "$ID-a" "$ID-b" "$ID-c" "$ID-r"; do
    ns_ok "$p" || continue
    "$REAL_DOCKER" compose -p "$p" down --volumes --remove-orphans >/dev/null 2>&1
    ref="$p-s:latest"
    [ "$("$REAL_DOCKER" image inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$ref" 2>/dev/null)" = "$p" ] \
      && "$REAL_DOCKER" image rm "$ref" >/dev/null 2>&1
  done
  # Root-owned test residue: deleted as root inside a namespaced container (never chowned).
  [ -d "$T/wsr" ] && "$REAL_DOCKER" run --rm --name "$ID-fixture" -v "$T/wsr:/w" node:20-slim rm -rf /w/renders >/dev/null 2>&1
  return 0
}
trap 'cleanup_docker; rm -rf "$T"' EXIT

# --- a scratch checkout: Git repo with the real .gitignore and a tracked .env --
mkrepo() {
  local d=$1
  mkdir -p "$d/compose"
  git -C "$d" init -q
  cp "$ROOT/.gitignore" "$d/.gitignore"
  printf 'SENTRY_DSN=\n' > "$d/.env"
  git -C "$d" add .gitignore .env
  git -C "$d" -c user.email=t@t -c user.name=t commit -qm init
}

# Stub for `wb-workspace port <slots>`: deterministic per stream.
cat > "$T/wb" <<'EOF'
#!/usr/bin/env bash
[ "$1" = port ] || exit 2; shift
[ -n "${WB_STUB_FAIL:-}" ] && { echo "collision" >&2; exit 3; }
base=11000; [ "$WORKSPACE_STREAM" = main ] || base=12000
i=1; for _ in "$@"; do echo $((base + i)); i=$((i + 1)); done
EOF
chmod +x "$T/wb"

run_setup() {   # run_setup <dir> <stream>
  local d=$1 s=$2 id="oceancanvas-$2"
  ( cd "$d" && env -u OC_GALLERY_PORT -u OC_PREFECT_PORT -u OC_RECIPE_PORT -u OC_EXPORT_PORT -u OC_VITE_PORT \
      WB_WORKSPACE="$T/wb" WORKSPACE_PROJECT=oceancanvas WORKSPACE_STREAM="$s" WORKSPACE_ID="$id" \
      WORKSPACE_PRIMARY="$T/main" WORKSPACE_PATH="$d" COMPOSE_PROJECT_NAME="$id" "$SETUP" )
}
val() { sed -n "s/^$2=//p" "$1/compose/.env"; }

echo "# setup"
mkrepo "$T/main"; mkrepo "$T/side"
out=$(run_setup "$T/main" main 2>&1); rc=$?
check "setup (primary) exits 0" [ "$rc" = 0 ]
check "1. generated file carries the marker" grep -q '^# Generated by .config/workspace/setup for oceancanvas-main' "$T/main/compose/.env"
check "1. COMPOSE_PROJECT_NAME persisted" [ "$(val "$T/main" COMPOSE_PROJECT_NAME)" = oceancanvas-main ]
check "1. PREFECT_HOME is checkout-local" [ "$(val "$T/main" PREFECT_HOME)" = "$T/main/.prefect" ]
check "5. ports persisted in slot order" [ "$(val "$T/main" OC_GALLERY_PORT) $(val "$T/main" OC_PREFECT_PORT) $(val "$T/main" OC_RECIPE_PORT) $(val "$T/main" OC_EXPORT_PORT) $(val "$T/main" OC_VITE_PORT)" = "11001 11002 11003 11004 11005" ]
check "1. only the expected keys" [ "$(grep -vc '^#' "$T/main/compose/.env")" = 7 ]
check "1. summary printed" grep -q 'oceancanvas workspace oceancanvas-main (primary): wrote compose/.env' <<<"$out"
check "generated file is ignored (tree stays clean)" [ -z "$(git -C "$T/main" status --porcelain)" ]

ino=$(stat -c %i "$T/main/compose/.env"); mt=$(stat -c %Y "$T/main/compose/.env")
out=$(run_setup "$T/main" main 2>&1); rc=$?
check "2. rerun exits 0" [ "$rc" = 0 ]
check "2. rerun reports unchanged" grep -q 'unchanged compose/.env' <<<"$out"
check "2. rerun leaves the file untouched" [ "$(stat -c %i "$T/main/compose/.env") $(stat -c %Y "$T/main/compose/.env")" = "$ino $mt" ]

run_setup "$T/side" fix-x >/dev/null 2>&1
check "4. side identity differs" [ "$(val "$T/side" COMPOSE_PROJECT_NAME)" = oceancanvas-fix-x ]
check "4. side ports differ from primary" [ "$(val "$T/side" OC_GALLERY_PORT)" = 12001 ]

mkrepo "$T/foreign"
printf 'COMPOSE_PROJECT_NAME=mine\n' > "$T/foreign/compose/.env"
out=$(run_setup "$T/foreign" main 2>&1); rc=$?
check "3. refuses a foreign compose/.env" [ "$rc" != 0 ]
check "3. foreign file untouched" [ "$(cat "$T/foreign/compose/.env")" = 'COMPOSE_PROJECT_NAME=mine' ]
check "3. says why" grep -q 'was not generated by this script' <<<"$out"

mkdir -p "$T/noignore/compose"; git -C "$T/noignore" init -q
out=$(run_setup "$T/noignore" main 2>&1); rc=$?
checks "refuses when compose/.env is not git-ignored" '[ "$rc" != 0 ] && [ ! -e "$T/noignore/compose/.env" ]'

mkrepo "$T/collide"
out=$(cd "$T/collide" && WB_STUB_FAIL=1 run_setup "$T/collide" main 2>&1); rc=$?
checks "port collision stops setup, nothing written" '[ "$rc" != 0 ] && [ ! -e "$T/collide/compose/.env" ]'

out=$(cd "$T/main" && env -u WORKSPACE_ID "$SETUP" 2>&1); rc=$?
check "refuses outside wb-workspace (identity missing)" [ "$rc" != 0 ]

check "15. tracked .env untouched" [ "$(cat "$T/main/.env")" = 'SENTRY_DSN=' ]
check "15. no new files besides compose/.env" [ "$(git -C "$T/main" status --porcelain --ignored --untracked-files=all | sort | tr '\n' ' ')" = '!! compose/.env ' ]
checks "15. no .env link or copy in the side stream" '[ ! -L "$T/side/.env" ] && [ "$(cat "$T/side/.env")" = SENTRY_DSN= ]'

echo "# compose resolution (real compose files, scratch copies)"
mkdir -p "$T/cmp/compose"; cp "$ROOT"/compose/docker-compose.yml "$ROOT"/compose/docker-compose.test.yml "$T/cmp/compose/"
cp "$ROOT/.env" "$T/cmp/.env"   # the pipeline's env_file (tracked, no secrets); not read for interpolation
cfg() { ( cd "$T/cmp" && env -u COMPOSE_PROJECT_NAME -u OC_GALLERY_PORT -u OC_PREFECT_PORT -u OC_RECIPE_PORT -u OC_EXPORT_PORT \
          docker compose -f "compose/$1" config 2>/dev/null ); }
pubs() { cfg "$1" | sed -n 's/^ *published: "\([0-9]*\)"/\1/p' | sort -n | tr '\n' ' '; }
check "6. default name without compose/.env" [ "$(cfg docker-compose.yml | sed -n 's/^name: //p')" = oceancanvas ]
check "6. default host ports without compose/.env" [ "$(pubs docker-compose.yml)" = "3001 3002 4200 8080 " ]
check "6. test stack: same default name" [ "$(cfg docker-compose.test.yml | sed -n 's/^name: //p')" = oceancanvas ]
check "test stack publishes nothing to the host" [ -z "$(pubs docker-compose.test.yml)" ]
cp "$T/side/compose/.env" "$T/cmp/compose/.env"
check "8. compose/.env sets the project name (prod)" [ "$(cfg docker-compose.yml | sed -n 's/^name: //p')" = oceancanvas-fix-x ]
check "8. compose/.env sets the project name (test)" [ "$(cfg docker-compose.test.yml | sed -n 's/^name: //p')" = oceancanvas-fix-x ]
check "8. compose/.env sets the host ports" [ "$(pubs docker-compose.yml)" = "12001 12002 12003 12004 " ]
check "8. compose/.env does not leak into containers" [ -z "$(cfg docker-compose.yml | grep -E 'OC_[A-Z]+_PORT|PREFECT_HOME')" ]

echo "# makefile"
mkdir -p "$T/mk/compose"; cp "$ROOT/Makefile" "$T/mk/"; printf 'probe:\n\t@echo "$$OC_GALLERY_PORT|$$OC_VITE_PORT|$$PREFECT_HOME"\n' >> "$T/mk/Makefile"
mkp() { ( cd "$T/mk" && env -u OC_GALLERY_PORT -u OC_VITE_PORT -u PREFECT_HOME "$@" make -s probe ); }
check "make: no compose/.env exports nothing" [ "$(mkp)" = "||" ]
cp "$T/side/compose/.env" "$T/mk/compose/.env"
check "make: exports compose/.env values" [ "$(mkp)" = "12001|12005|$T/side/.prefect" ]
check "make: a shell value wins" [ "$(mkp OC_GALLERY_PORT=9999)" = "9999|12005|$T/side/.prefect" ]

echo "# vite (real gallery/vite.config.ts, scratch envDir)"
if [ -d "$ROOT/gallery/node_modules/vite" ]; then
  mkdir -p "$T/vt/gallery" "$T/vt/compose"
  cp "$ROOT/gallery/vite.config.ts" "$ROOT/gallery/package.json" "$T/vt/gallery/"
  ln -s "$ROOT/gallery/node_modules" "$T/vt/gallery/node_modules"
  probe='import { resolveConfig } from "vite";
const c = await resolveConfig({ root: process.cwd(), logLevel: "silent" }, "serve", "development");
const p = c.server.proxy;
console.log([c.server.port, c.server.strictPort, p["/data"], p["/api"], p["/api/export"], p["^/recipes/.+\\.yaml$"]].join(" "));'
  vite_cfg() { ( cd "$T/vt/gallery" && env -u OC_GALLERY_PORT -u OC_RECIPE_PORT -u OC_EXPORT_PORT -u OC_VITE_PORT "$@" "$NODE" --input-type=module -e "$probe" 2>&1 ); }
  check "6. vite defaults without compose/.env" [ "$(vite_cfg)" = "5173 false http://localhost:8080 http://localhost:3001 http://localhost:3002 http://localhost:8080" ]
  cp "$T/side/compose/.env" "$T/vt/compose/.env"
  check "7. vite: workspace port, strict, this checkout's proxy targets" [ "$(vite_cfg)" = "12005 true http://localhost:12001 http://localhost:12003 http://localhost:12004 http://localhost:12001" ]
  check "7. vite: a shell value wins" [ "$(vite_cfg OC_VITE_PORT=9998)" = "9998 true http://localhost:12001 http://localhost:12003 http://localhost:12004 http://localhost:12001" ]
else
  bad "vite tests need gallery/node_modules (run the bootstrap first)"
fi

echo "# teardown: contract against a fake docker (real daemon unreachable)"
mkdir -p "$T/fakebin" "$T/guardbin" "$T/wsa" "$T/wsb" "$T/wsr/renders"
cat > "$T/fakebin/docker" <<'EOF'
#!/usr/bin/env bash
# Records every call; never contacts a daemon.
printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"
case "$1" in info) [ -z "${FAKE_DOCKER_DOWN:-}" ] ;; *) exit 0 ;; esac
EOF
chmod +x "$T/fakebin/docker"
NODAEMON="unix://$T/no-daemon.sock"

td_fake() {   # td_fake <teardown script> <workspace dir> <stream> <project>
  : > "$T/fake.log"
  ( PATH="$T/fakebin:$PATH" DOCKER_HOST="$NODAEMON" DOCKER_CONTEXT= FAKE_DOCKER_LOG="$T/fake.log" \
      WORKSPACE_STREAM="$3" WORKSPACE_PATH="$2" COMPOSE_PROJECT_NAME="$4" "$1" ) >/dev/null 2>&1
}
calls() { tr '\n' ';' < "$T/fake.log"; }
P=oceancanvas-x
SIDE_CALLS="info;compose -p $P down --remove-orphans;compose -p $P down --remove-orphans --volumes;"
MAIN_CALLS="info;compose -p $P down --remove-orphans;"
STOP_CALLS="info;compose -p $P down --remove-orphans;"

if [ -n "$REAL_DOCKER" ]; then
  checks "fake env: the real docker binary cannot reach a daemon" '! DOCKER_HOST="$NODAEMON" DOCKER_CONTEXT= "$REAL_DOCKER" info >/dev/null 2>&1'
fi

# Root-owned fixture for the residue scenarios (harness-made, namespaced, --rm).
have_residue=0
if real_docker_ok; then
  "$REAL_DOCKER" run --rm --name "$ID-fixture" -v "$T/wsr/renders:/r" node:20-slim \
    sh -c 'mkdir -p /r/recipe && touch /r/recipe/2026-01-01.png /r/manifest.json' >/dev/null && have_residue=1
fi

# contract <teardown>: 0 iff every scenario issues exactly the allowed calls.
contract() {
  local s=$1 rc
  td_fake "$s" "$T/wsa" side "$P";   rc=$?; [ "$rc" = 0 ] && [ "$(calls)" = "$SIDE_CALLS" ] || return 1
  td_fake "$s" "$T/wsb" main "$P";   rc=$?; [ "$rc" = 0 ] && [ "$(calls)" = "$MAIN_CALLS" ] || return 1
  if [ "$have_residue" = 1 ]; then
    td_fake "$s" "$T/wsr" side "$P"; rc=$?; [ "$rc" != 0 ] && [ "$(calls)" = "$STOP_CALLS" ] || return 1
  fi
  return 0
}

td_fake "$TEARDOWN" "$T/wsa" side "$P"; rc=$?
checks "side: exactly down, then down --volumes, both -p <project>" '[ "$rc" = 0 ] && [ "$(calls)" = "$SIDE_CALLS" ]'
td_fake "$TEARDOWN" "$T/wsb" main "$P"; rc=$?
checks "primary: exactly one down -p <project>, no --volumes" '[ "$rc" = 0 ] && [ "$(calls)" = "$MAIN_CALLS" ]'
FAKE_DOCKER_DOWN=1 td_fake "$TEARDOWN" "$T/wsa" side "$P"; rc=$?
checks "daemon unreachable: success, no Compose call" '[ "$rc" = 0 ] && [ "$(calls)" = "info;" ]'
td_fake "$TEARDOWN" "$T/wsa" side "Bad Name"; rc=$?
checks "unusable project name: refused before any docker call" '[ "$rc" != 0 ] && [ -z "$(calls)" ]'
check "no image, prune, rm or label-selector call in any scenario" contract "$TEARDOWN"
if [ "$have_residue" = 1 ]; then
  td_fake "$TEARDOWN" "$T/wsr" side "$P"; rc=$?
  checks "14. blocking residue: refused after stopping, volumes untouched" '[ "$rc" != 0 ] && [ "$(calls)" = "$STOP_CALLS" ]'
else
  echo "skip residue scenarios (no Docker to create a root-owned fixture)"
fi

echo "# teardown: mutations (fake docker only; these copies never reach a daemon)"
mutant() {   # mutant <label> <sed script | append:LINE>
  local m="$T/mut-$1"
  cp "$TEARDOWN" "$m"
  case "$2" in
    append:*) sed -i "\$i ${2#append:}" "$m" ;;
    *) sed -i "$2" "$m" ;;
  esac
  if cmp -s "$TEARDOWN" "$m"; then bad "mutation $1 was not applied"; return; fi
  if contract "$m"; then bad "mutation $1 NOT detected"; else ok "mutation $1 detected"; fi
}
mutant primary-guard 's/^side=1; \[ "\$WORKSPACE_STREAM" = main \] && side=0$/side=1/'
mutant other-project 's/-p "\$NAME"/-p "orrery-main"/g'
mutant no-project 's/ -p "\$NAME"//g'
mutant broad-image-cleanup 'append:docker image ls -q --filter label=com.docker.compose.project | xargs -r docker image rm'
mutant prune 'append:docker system prune -af'
mutant volume-rm-by-label 'append:docker volume ls -q --filter label=com.docker.compose.project | xargs -r docker volume rm'
[ "$have_residue" = 1 ] && mutant residue-never-blocks 's/blocking=1$/blocking=0/'

echo "# teardown: real daemon (unmodified teardown, guard shim, namespace snapshot)"
if ! real_docker_ok; then
  echo "skip real-daemon teardown tests (OC_WS_TEST_NO_DOCKER=1 or no daemon)"
else
  cat > "$T/guardbin/docker" <<EOF
#!/usr/bin/env bash
# Independent safety boundary: allows only what teardown may do, in the test namespace.
REAL='$REAL_DOCKER'; NS='$NS_RE'; LOG='$T/guard.log'
EOF
  cat >> "$T/guardbin/docker" <<'EOF'
refuse() { echo "REFUSED: docker $*" >> "$LOG"; echo "guard: refused docker $*" >&2; exit 97; }
case "${1:-}" in
  info) exec "$REAL" "$@" ;;
  compose)
    [ "${2:-}" = -p ] && [[ ${3:-} =~ $NS ]] && [ "${4:-}" = down ] || refuse "$@"
    for a in "${@:5}"; do case "$a" in --remove-orphans|--volumes) ;; *) refuse "$@" ;; esac; done
    exec "$REAL" "$@" ;;
  *) refuse "$@" ;;
esac
EOF
  chmod +x "$T/guardbin/docker"; : > "$T/guard.log"
  # The boundary itself, proven with names that exist nowhere (harmless even if it were broken).
  gd() { PATH="$T/guardbin:$PATH" docker "$@" >/dev/null 2>&1; echo $?; }
  check "guard refuses compose down outside the namespace" [ "$(gd compose -p oc-guardprobe-none down)" = 97 ]
  check "guard refuses compose down without -p" [ "$(gd compose down --volumes)" = 97 ]
  check "guard refuses extra compose flags (e.g. --rmi)" [ "$(gd compose -p "$ID-none" down --rmi all)" = 97 ]
  check "guard refuses image removal" [ "$(gd image rm oc-guardprobe-none:none)" = 97 ]
  check "guard refuses prune" [ "$(gd system prune -af)" = 97 ]
  check "guard allows the namespaced down" [ "$(gd compose -p "$ID-none" down --remove-orphans)" = 0 ]
  : > "$T/guard.log"
  td() {   # td <workspace dir> <stream> <project>: unmodified teardown, guarded
    ns_ok "$3" || { bad "harness refused: $3 is outside the test namespace"; return 99; }
    ( PATH="$T/guardbin:$PATH" WORKSPACE_STREAM="$2" WORKSPACE_PATH="$1" COMPOSE_PROJECT_NAME="$3" "$TEARDOWN" )
  }
  snapshot() {
    { "$REAL_DOCKER" ps -a --no-trunc --format 'container {{.ID}} {{.Names}} {{.State}} {{.Image}}'
      "$REAL_DOCKER" image ls --no-trunc --format 'image {{.ID}} {{.Repository}}:{{.Tag}}'
      "$REAL_DOCKER" volume ls --format 'volume {{.Name}}'
      "$REAL_DOCKER" network ls --no-trunc --format 'network {{.ID}} {{.Name}}'
    } | grep -v -- "$ID-" | sort
  }
  n() { "$REAL_DOCKER" "$1" ls -q --filter "label=com.docker.compose.project=$2" "${@:3}" | wc -l; }
  snapshot > "$T/before"

  out=$(td "$T/wsa" side "$ID-a" 2>&1); rc=$?
  check "9. teardown with nothing running succeeds" [ "$rc" = 0 ]

  mkdir -p "$T/proj"
  printf 'FROM node:20-slim\n' > "$T/proj/Dockerfile"
  cat > "$T/proj/compose.yml" <<'EOF'
services:
  s:
    build: .
    init: true
    command: ["sleep", "infinity"]
    volumes:
      - state:/data
volumes:
  state: {}
EOF
  # a = this stream; b = another stream, running; c = another project's built,
  # unused image (no container at all, so Docker would let anyone delete it).
  for p in "$ID-a" "$ID-b"; do
    "$REAL_DOCKER" compose -p "$p" -f "$T/proj/compose.yml" up -d --build >/dev/null 2>&1 || bad "could not start fixture project $p"
  done
  "$REAL_DOCKER" compose -p "$ID-c" -f "$T/proj/compose.yml" build >/dev/null 2>&1 || bad "could not build fixture image $ID-c"
  check "fixtures: a and b have container, network, volume, image" [ "$(n container "$ID-a" -a)$(n network "$ID-a")$(n volume "$ID-a")$(n image "$ID-a")$(n container "$ID-b" -a)$(n network "$ID-b")$(n volume "$ID-b")$(n image "$ID-b")" = 11111111 ]
  check "fixture c: Compose-built image labelled with a foreign project" [ "$("$REAL_DOCKER" image inspect -f '{{ index .Config.Labels "com.docker.compose.project" }}' "$ID-c-s:latest" 2>/dev/null)" = "$ID-c" ]
  check "fixture c: no container references it (genuinely removable)" [ -z "$("$REAL_DOCKER" ps -aq --filter "ancestor=$ID-c-s:latest")" ]

  out=$(td "$T/wsa" side "$ID-a" 2>&1); rc=$?
  check "10. side teardown exits 0" [ "$rc" = 0 ]
  check "10. side: its containers are gone" [ "$(n container "$ID-a" -a)" = 0 ]
  check "10. side: its network is gone" [ "$(n network "$ID-a")" = 0 ]
  check "12. side: its volumes are gone" [ "$(n volume "$ID-a")" = 0 ]
  check "13. side: its image is kept (images are never removed by teardown)" [ "$(n image "$ID-a")" = 1 ]
  check "11. foreign running container survives" [ "$("$REAL_DOCKER" ps -q --filter "label=com.docker.compose.project=$ID-b" | wc -l)" = 1 ]
  check "11. foreign network survives" [ "$(n network "$ID-b")" = 1 ]
  check "12. foreign volume survives" [ "$(n volume "$ID-b")" = 1 ]
  check "13. foreign image (in use) survives" [ "$(n image "$ID-b")" = 1 ]
  check "13. REGRESSION: foreign unused Compose-built image survives" [ "$(n image "$ID-c")" = 1 ]
  out=$(td "$T/wsa" side "$ID-a" 2>&1); rc=$?
  check "teardown is idempotent" [ "$rc" = 0 ]

  out=$(td "$T/wsb" main "$ID-b" 2>&1); rc=$?
  check "primary teardown exits 0" [ "$rc" = 0 ]
  check "primary: containers removed" [ "$(n container "$ID-b" -a)" = 0 ]
  check "primary: volume kept" [ "$(n volume "$ID-b")" = 1 ]
  check "primary: image kept" [ "$(n image "$ID-b")" = 1 ]

  out=$(td "$T/wsr" side "$ID-r" 2>&1); rc=$?
  check "14. blocking root-owned residue refuses teardown" [ "$rc" != 0 ]
  check "14. lists the blocking path" grep -qE 'BLOCKING\) +renders/recipe/2026-01-01.png' <<<"$out"
  check "14. worktree contents preserved" [ -e "$T/wsr/renders/recipe/2026-01-01.png" ]
  "$REAL_DOCKER" run --rm --name "$ID-fixture" -v "$T/wsr/renders:/r" node:20-slim rm -rf /r/recipe >/dev/null
  out=$(td "$T/wsr" side "$ID-r" 2>&1); rc=$?
  checks "14. removable root-owned file only: teardown proceeds" '[ "$rc" = 0 ] && grep -q "removable)  renders/manifest.json" <<<"$out"'

  check "guard: the unmodified teardown never needed a refused call" [ ! -s "$T/guard.log" ]
  cleanup_docker
  snapshot > "$T/after"
  if diff "$T/before" "$T/after" >/dev/null; then
    ok "nothing outside the $ID- namespace changed (containers, images, volumes, networks)"
  else
    bad "Docker state outside the test namespace changed (another process, or a scoping bug):"
    diff "$T/before" "$T/after" | sed 's/^/     /'
  fi
fi

echo "# $pass passed, $fail failed"
[ "$fail" = 0 ]
