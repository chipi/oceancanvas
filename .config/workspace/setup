#!/usr/bin/env bash
# OceanCanvas workspace setup. Run through `wb-workspace setup` (the
# workstation's generic Model-B layer): by the Worktrunk pre-start hook for a
# new stream, by hand once in the primary checkout. Contract: README.md here.
#
# Writes exactly one git-ignored, generated file and nothing else:
#   compose/.env   this checkout's Compose project name, host ports and
#                  PREFECT_HOME. Compose reads it automatically for every
#                  `docker compose -f compose/...` run; the Makefile and
#                  gallery/vite.config.ts read the same values.
# Every checkout set up this way (the primary too) gets its own collision-
# checked ports from `wb-workspace port`; without compose/.env (CI, a plain
# clone) the repository defaults apply. Never installs dependencies, builds or
# starts Docker, or touches .env / secrets.
set -euo pipefail

die()  { echo "oceancanvas setup: $*" >&2; exit 1; }
note() { echo "oceancanvas setup: $*" >&2; }

for v in WORKSPACE_PROJECT WORKSPACE_STREAM WORKSPACE_ID WORKSPACE_PRIMARY WORKSPACE_PATH COMPOSE_PROJECT_NAME; do
  [ -n "${!v:-}" ] || die "$v is not set; run this through 'wb-workspace setup'"
done
[ $# -eq 0 ] || die "unexpected argument '$1' (usage: wb-workspace setup)"
WB="${WB_WORKSPACE:-wb-workspace}"   # override only for the tests

cd "$WORKSPACE_PATH"
ENV_FILE=compose/.env
MARK='# Generated by .config/workspace/setup for'
[ -d compose ] || die "no compose/ directory in $WORKSPACE_PATH"

# The file must never show up as an untracked file (wb-integrate refuses then).
git check-ignore -q "$ENV_FILE" \
  || die "$ENV_FILE is not git-ignored in this checkout; refusing to generate it"

# Only ever replace a file this script generated (first line carries the mark).
if [ -e "$ENV_FILE" ] || [ -L "$ENV_FILE" ]; then
  { [ -f "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ] && head -n1 "$ENV_FILE" | grep -qF "$MARK"; } \
    || die "$ENV_FILE exists and was not generated by this script; move it aside, then rerun"
fi

# One call, every slot; wb-workspace fails (and prints no ports) on a collision.
SLOTS=(gallery prefect recipe-api export-api vite)
VARS=(OC_GALLERY_PORT OC_PREFECT_PORT OC_RECIPE_PORT OC_EXPORT_PORT OC_VITE_PORT)
ports=$("$WB" port "${SLOTS[@]}") || die "could not derive ports for $WORKSPACE_ID"
mapfile -t P <<<"$ports"
[ "${#P[@]}" = "${#SLOTS[@]}" ] || die "expected ${#SLOTS[@]} ports from '$WB port', got: $ports"
for p in "${P[@]}"; do [[ $p =~ ^[0-9]+$ ]] || die "not a port from '$WB port': $p"; done

body() {
  echo "$MARK $WORKSPACE_ID — rerun 'wb-workspace setup' instead of editing."
  echo "# Read by docker compose (-f compose/...), the Makefile and gallery/vite.config.ts."
  echo "# Runtime defaults only: a value set in the shell wins. Never secrets."
  echo "COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME"
  for i in "${!VARS[@]}"; do echo "${VARS[$i]}=${P[$i]}"; done
  echo "PREFECT_HOME=$WORKSPACE_PATH/.prefect"
}

new=$(body)
if [ -f "$ENV_FILE" ] && [ "$(cat "$ENV_FILE")" = "$new" ]; then
  state=unchanged
else
  tmp=$(mktemp "$ENV_FILE.tmp.XXXXXX")
  printf '%s\n' "$new" > "$tmp"
  mv -f "$tmp" "$ENV_FILE"
  state=wrote
fi

kind="side stream"; [ "$WORKSPACE_STREAM" = main ] && kind=primary
echo "oceancanvas workspace $WORKSPACE_ID ($kind): $state $ENV_FILE"
echo "  compose project  $COMPOSE_PROJECT_NAME"
echo "  gallery (Caddy)  http://localhost:${P[0]}"
echo "  prefect UI       http://localhost:${P[1]}"
echo "  recipe api       ${P[2]}    export api  ${P[3]}"
echo "  vite dev         http://localhost:${P[4]} (strict)"
echo "  dependencies     not installed by setup; see .config/workspace/README.md (Bootstrap)"

# A shell value silently wins over compose/.env; say so.
for i in "${!VARS[@]}"; do
  v=${VARS[$i]}
  if [ -n "${!v:-}" ] && [ "${!v}" != "${P[$i]}" ]; then
    note "warning: $v=${!v} is set in this shell and overrides $ENV_FILE (${P[$i]})"
  fi
done
exit 0
