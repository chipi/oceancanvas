:8080 {
    # Specific prefixes first — each handle is mutually exclusive (first match wins).
    # Do not use a global root + file_server above these: /renders/* would fall
    # through to SPA try_files and return index.html (breaking JSON.parse on manifest).

    handle /api/* {
        reverse_proxy {$RECIPE_SERVER:localhost:3001}
    }

    handle /data/* {
        root * /
        file_server
    }

    handle /renders/* {
        root * /
        file_server
    }

    handle /manifest.json {
        rewrite * /renders/manifest.json
        root * /
        file_server
    }

    # Only recipe YAML is static; /recipes/:id is a React route (align with Vite proxy).
    @recipeYaml path_regexp ^/recipes/.+\.yaml$
    handle @recipeYaml {
        root * /
        file_server
    }

    handle /sketches/* {
        root * /
        file_server
    }

    handle /audio/* {
        root * /
        file_server
    }

    # React build (Vite): static files + SPA fallback — must be last
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format json
    }
}
